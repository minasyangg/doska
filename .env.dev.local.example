# Скопируйте в .env.dev.local и подставьте значения. Запуск: npm run dev

# Supabase-проект, который выдаёт учителям access-токены. Доска не хранит
# в нём данных — только проверяет через него личность (см. verifySupabaseUser
# в server.js). Без этих двух переменных роль учителя недоступна: все входят
# учениками, список досок пуст.
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable-ключ проекта (Project Settings → API Keys). Если в проекте
# ещё жив legacy anon-ключ — подойдёт и он, но новые проекты его отключают.
SUPABASE_ANON_KEY=sb_publishable_<...>

# Ключ шифрования сессий. Обязателен: в файлах сессий лежат токены Supabase,
# то есть по сути ключи от аккаунтов mcko-app. Не короче 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Без него доска поднимется, но на временном ключе — все входы слетят при
# перезапуске.
SESSION_SECRET=

# Общий секрет с mcko-app для бесшовного перехода. Тем же значением должна быть
# заполнена переменная DOSKA_SSO_SECRET на стороне mcko-app. Пусто = перехода
# по кнопке «Доска» не будет, но обычный вход почтой и паролем работает.
DOSKA_SSO_SECRET=

# Адрес mcko-app. Нужен для обратного направления: человек открыл ссылку на
# доску, своей сессии здесь у него нет — вместо формы входа доска отправит его
# в mcko-app, и если он там уже вошёл, вернётся сюда с готовой сессией, ничего
# не вводя. Пусто = всегда своя форма входа.
MCKO_URL=https://mcko-app.vercel.app

# Порт. Должен совпадать с DOSKA_URL на стороне mcko-app.
PORT=8080

# Доска за обратным прокси (Caddy, nginx): брать протокол из X-Forwarded-Proto,
# иначе кука сессии не получит флаг Secure.
# TRUST_PROXY=1

# Папка с досками и картинками. Пусто = ./data рядом с server.js.
# На хостинге с эфемерным диском обязательно укажите постоянный том.
# DATA_DIR=
